<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="competition_retreat_route">
    <Sequence>
      <Timeout msec="60000">
        <SendNav2Goal goal="6.0;5.25;0.0" action_name="navigate_to_pose"/>
      </Timeout>
      <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
      <Timeout msec="60000">
        <SendNav2Goal goal="6.0;0.0;0.0" action_name="navigate_to_pose"/>
      </Timeout>
      <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
      <Timeout msec="60000">
        <SendNav2Goal goal="0.0;0.0;0.0" action_name="navigate_to_pose"/>
      </Timeout>
      <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="competition_retreat_navigation">
    <RetryUntilSuccessful num_attempts="-1">
      <Fallback>
        <Sequence>
          <SubTree ID="competition_retreat_route"/>
          <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
        </Sequence>
        <Sequence>
          <IsHpLow threshold="0"/>
          <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
        </Sequence>
        <ForceFailure>
          <Sequence>
            <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
            <Sleep msec="2000"/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- Both the formal and manual entry must provide a live stage gate. -->
  <BehaviorTree ID="competition_retreat_active">
    <Sequence>
      <PublishAutoAim value="0" duration="0" topic_name="auto_aim_switch"/>
      <PublishSpinSpeed spin_speed="0" duration="0" topic_name="cmd_spin"/>
      <PublishGimbalVelocity gimbal_vel_yaw="0.5" gimbal_vel_pitch="0"
                             yaw_min="-3.14159" yaw_max="3.14159"
                             pitch_min="-0.3" pitch_max="0.3"
                             duration="0" topic_name="gimbal_scan_cmd"/>
      <Parallel success_count="1" failure_count="1">
        <SubTree ID="competition_retreat_navigation"/>
        <KeepRunningUntilFailure>
          <Sequence>
            <PublishAutoAim value="0" duration="0" topic_name="auto_aim_switch"/>
            <PublishSpinSpeed spin_speed="0" duration="0" topic_name="cmd_spin"/>
            <PublishGimbalVelocity gimbal_vel_yaw="0.5" gimbal_vel_pitch="0"
                                   yaw_min="-3.14159" yaw_max="3.14159"
                                   pitch_min="-0.3" pitch_max="0.3"
                                   duration="0" topic_name="gimbal_scan_cmd"/>
          </Sequence>
        </KeepRunningUntilFailure>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="competition_retreat">
    <ReactiveSequence>
      <IsGameStatus expected_game_progress="4" min_remain_time="0" max_remain_time="65535"/>
      <SubTree ID="competition_retreat_active"/>
    </ReactiveSequence>
  </BehaviorTree>
</root>
