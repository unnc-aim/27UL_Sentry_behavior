<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="competition_retreat_route">
    <!-- 撤退一次提交逆序六点，终点停车沿用外层 PublishTwist。 -->
    <Timeout msec="300000">
      <SendNav2ThroughPoses
        goals="-16.6229;9.1474;-0.2643|-23.4204;6.9017;1.2294|-27.0898;7.7037;-0.3465|-26.7891;11.3130;-1.7359|-21.7160;10.5510;3.0500|-16.3622;8.9870;2.8198"
        action_name="navigate_through_poses"/>
    </Timeout>
  </BehaviorTree>

  <BehaviorTree ID="competition_retreat_navigation">
    <RetryUntilSuccessful num_attempts="-1">
      <Fallback>
        <Sequence>
          <SubTree ID="competition_retreat_route"/>
          <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
        </Sequence>
        <Sequence>
          <IsHpLow threshold="0"/>
          <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
        </Sequence>
        <ForceFailure>
          <Sequence>
            <PublishTwist v_x="0" v_y="0" v_yaw="0" duration="0" topic_name="cmd_vel"/>
            <Sleep msec="2000"/>
          </Sequence>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <!-- 撤退保持底盘 2.2rad/s，云台复用运动方向跟随；比赛状态由外层检查。 -->
  <BehaviorTree ID="competition_retreat_active">
    <Sequence>
      <PublishAutoAim value="0" duration="0" topic_name="auto_aim_switch"/>
      <PublishSpinSpeed spin_speed="2.2" duration="0" topic_name="cmd_spin"/>
      <Parallel success_count="1" failure_count="1">
        <SubTree ID="competition_retreat_navigation"/>
        <KeepRunningUntilFailure>
          <Sequence>
            <PublishAutoAim value="0" duration="0" topic_name="auto_aim_switch"/>
            <PublishSpinSpeed spin_speed="2.2" duration="0" topic_name="cmd_spin"/>
          </Sequence>
        </KeepRunningUntilFailure>
      </Parallel>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="competition_retreat">
    <ReactiveSequence>
      <IsGameStatus expected_game_progress="4" min_remain_time="0" max_remain_time="65535"/>
      <SubTree ID="competition_retreat_active"/>
    </ReactiveSequence>
  </BehaviorTree>
</root>
