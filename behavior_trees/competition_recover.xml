    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="competition_recover">
    <ReactiveSequence>
      <IsGameStatus expected_game_progress="4" min_remain_time="0" max_remain_time="65535"/>
      <SubTree ID="competition_recover_active"/>
